{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-valaiyagam-admin",
    "name": "Valaiyagam Admin API",
    "description": "Postman collection for the mounted admin FastAPI surface (`/api/v1`).\n\n1. Set collection variables `baseUrl` and admin credentials.\n2. Run **Auth → Login** to store `accessToken`.\n3. Other authenticated requests use `Bearer {{accessToken}}`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api/v1" },
    { "key": "origin", "value": "http://localhost:8000" },
    { "key": "accessToken", "value": "" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "ChangeMe123!" },
    { "key": "productId", "value": "1" },
    { "key": "categoryId", "value": "1" },
    { "key": "orderId", "value": "1" },
    { "key": "cartId", "value": "1" },
    { "key": "shipmentId", "value": "1" },
    { "key": "customerId", "value": "1" },
    { "key": "paymentId", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{origin}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.access_token) {",
                  "    pm.collectionVariables.set('accessToken', data.access_token);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "{{adminEmail}}" },
                { "key": "password", "value": "{{adminPassword}}" }
              ]
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
