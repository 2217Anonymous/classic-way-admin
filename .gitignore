# =============================================================================
# Valaiyagam / classic-way-admin — root ignore rules
# =============================================================================

# --- Secrets & local env (never commit) ---
.env
.env.*
!.env.example
!env-sample.txt
**/local.settings.json
**/secrets/

# --- OS / editor ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# --- Python (backend) ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.envrc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
*.log

# --- Node / Next.js (frontend) ---
node_modules/
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Uploads & runtime data ---
admin/backend/uploads/
**/uploads/**
!**/uploads/.gitkeep

# --- Docker / local volumes ---
*.sql.gz
*.dump
pgdata/
postgres-data/

# --- Misc ---
*.pem
*.key
coverage/
.cursor/
.claude/
